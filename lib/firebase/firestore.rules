rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rule to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Admin access is granted via the `admin` custom claim (see scripts/set-admin.js)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    // User document rules
    match /users/{userId} {
      // Allow users to read and write only their own user document
      allow read, write: if isOwner(userId);
      
      // Expenses subcollection — ownership + field-level validation on writes
      match /expenses/{expenseId} {
        function validExpense(data) {
          return data.amount is number
              && data.amount > 0
              && data.amount <= 1000000
              && data.category is string
              && data.category.size() > 0
              && data.category.size() <= 50
              && data.description is string
              && data.description.size() > 0
              && data.description.size() <= 500
              && data.date is timestamp
              && data.date <= request.time
              && (!('location' in data) || (data.location is string && data.location.size() <= 200))
              && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
              && (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'card', 'bank', 'wallet'])
              && (!('recurringId' in data) || (data.recurringId is string && data.recurringId.size() <= 100))
              && (!('receiptPath' in data) || (data.receiptPath is string && data.receiptPath.size() <= 300));
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validExpense(request.resource.data);
        allow update: if isOwner(userId) && validExpense(request.resource.data);
        allow delete: if isOwner(userId);
      }
      
      // Recurring expense rules (rent, subscriptions…). The app creates the actual
      // expenses from these when they fall due.
      match /recurring/{ruleId} {
        function validRule(data) {
          return data.amount is number
              && data.amount > 0
              && data.amount <= 1000000
              && data.category is string
              && data.category.size() > 0
              && data.category.size() <= 50
              && data.description is string
              && data.description.size() > 0
              && data.description.size() <= 500
              && data.frequency in ['weekly', 'monthly']
              && data.startDate is timestamp
              && data.nextDue is timestamp
              && data.active is bool;
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validRule(request.resource.data);
      }

      // Settings subcollection - added for categories
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
      
      // Add rules for other user-specific subcollections if needed
      // For example, if you add budgets or incomes back in the future:
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
      
      match /incomes/{incomeId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Rules for notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow write: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Rules for logs collection
    match /logs/{logId} {
      // Users can read their own logs OR admin users can read all logs
      allow read: if isSignedIn() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      // Allow system to write logs
      allow create: if isSignedIn();
      // Prevent updates and deletes from clients (except for admin deletion)
      allow update: if false;
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Add any additional collections needed for your application
    // For example, if you have shared data:
    match /sharedData/{docId} {
      allow read: if isSignedIn();
      // Restrict writes to specific conditions as needed
    }

    // Rules for phone-handoff scan sessions (QR-code receipt capture)
    match /scan-sessions/{sid} {
      // Only the creator (desktop, signed in) can read the image back
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.createdBy;

      // Desktop creates sessions; must stamp their own uid and status=waiting
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == "waiting"
                    && !('imageData' in request.resource.data)
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt < request.time + duration.value(10, 'm');

      // Phone uploads image ONCE — allowed without auth but constrained
      allow update: if resource.data.status == "waiting"
                    && resource.data.expiresAt > request.time
                    && request.resource.data.status == "received"
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && request.resource.data.imageData is string
                    && request.resource.data.imageData.size() < 900000;

      // Creator can delete (cleanup on dialog close / success)
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.createdBy;
    }
  }
}